---
import '../styles/global.css';
import { SITE_INDEXABLE } from '../data/site';

interface Props {
	title: string;
	description: string;
	coverImage?: string;
}

const { title, description, coverImage } = Astro.props;
const siteName = 'ArenaForge';
const cfAnalyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="vi">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#121014" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta
			name="robots"
			content={SITE_INDEXABLE ? 'index, follow' : 'noindex, nofollow'}
		/>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="vi_VN" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{coverImage && <meta property="og:image" content={coverImage} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{coverImage && <meta name="twitter:image" content={coverImage} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
	</head>
	<body class="flex min-h-screen flex-col bg-background text-text">
		<slot name="navbar" />
		<main class="flex-1">
			<slot />
		</main>
		<slot name="footer" />

		{
			cfAnalyticsToken && (
				<script
					defer
					src="https://static.cloudflareinsights.com/beacon.min.js"
					data-cf-beacon={`{"token": "${cfAnalyticsToken}"}`}
				/>
			)
		}
	</body>
</html>
