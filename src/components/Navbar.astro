---
const youtubeUrl = import.meta.env.PUBLIC_YOUTUBE_URL || 'https://www.youtube.com';
const tiktokUrl = import.meta.env.PUBLIC_TIKTOK_URL || 'https://www.tiktok.com';
---

<header class="border-b border-border bg-background">
	<div
		class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-4 gap-y-3 px-4 py-3 md:h-16 md:flex-nowrap md:py-0"
	>
		<a href="/" class="text-xl font-bold tracking-tight text-text">ArenaForge</a>

		<input id="navbar-menu" type="checkbox" class="peer sr-only" />

		<label
			for="navbar-menu"
			class="ml-auto inline-flex cursor-pointer items-center justify-center rounded-button p-2 text-text-muted hover:text-text peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-accent md:hidden"
		>
			<span class="sr-only">Mở menu</span>
			<svg
				class="h-6 w-6"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				aria-hidden="true"
			>
				<path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
			</svg>
		</label>

		<div
			class="hidden w-full flex-col gap-3 peer-checked:flex md:ml-auto md:flex md:w-auto md:flex-row md:items-center"
		>
			<form role="search" class="w-full md:w-64">
				<label for="site-search" class="sr-only">Tìm kiếm game</label>
				<input
					id="site-search"
					type="search"
					name="q"
					placeholder="Tìm game..."
					class="w-full rounded-button border border-border bg-card px-3 py-2 text-sm text-text placeholder:text-text-muted focus:border-accent focus:outline-none"
				/>
			</form>

			<nav aria-label="Mạng xã hội" class="flex items-center gap-2">
				<a
					href={youtubeUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="YouTube"
					class="inline-flex items-center justify-center rounded-button p-2 text-text-muted hover:text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"
						/>
					</svg>
				</a>
				<a
					href={tiktokUrl}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="TikTok"
					class="inline-flex items-center justify-center rounded-button p-2 text-text-muted hover:text-text focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
				>
					<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path
							d="M19.6 6.7a5.7 5.7 0 0 1-3.4-1.1 5.7 5.7 0 0 1-2.1-3.1h-3v12.1a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9a5.6 5.6 0 1 0 4.8 5.6V7.9a8.6 8.6 0 0 0 5.5 1.9V6.7Z"
						/>
					</svg>
				</a>
			</nav>
		</div>
	</div>
</header>
