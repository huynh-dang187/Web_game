---
const links = [
	{ label: 'About', href: '/about' },
	{ label: 'Contact', href: '/contact' },
	{ label: 'How to Download', href: '/how-to-download' },
	{ label: 'Privacy', href: '/legal' },
];
---

<footer class="border-t border-border bg-background">
	<div
		class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-6 text-sm text-text-muted md:flex-row md:items-center md:justify-between"
	>
		<nav aria-label="Chân trang">
			<ul class="flex flex-wrap gap-x-4 gap-y-2">
				{
					links.map((link) => (
						<li>
							<a href={link.href} class="hover:text-text">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p>All games are original creations</p>
	</div>
</footer>
