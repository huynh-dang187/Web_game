---
import type { Game } from '../types/game';

interface Props {
	game: Game;
}

const { game } = Astro.props;
---

<article
	class="flex h-full flex-col overflow-hidden rounded-card border border-border bg-card"
	data-game-card="true"
	data-platform={game.platform}
	data-title={game.title.toLowerCase()}
>
	<a href={`/games/${game.slug}`} class="block aspect-video overflow-hidden border-b border-border">
		<img
			src={game.coverImage}
			alt={`Ảnh bìa ${game.title}`}
			width="800"
			height="450"
			loading="lazy"
			class="h-full w-full object-cover"
		/>
	</a>

	<div class="flex flex-1 flex-col gap-3 p-4">
		<div class="flex flex-wrap items-center gap-2">
			<span class="rounded-button bg-accent-2 px-2 py-1 text-xs font-semibold text-accent-foreground">
				{game.platform}
			</span>
			{
				game.genres.map((genre) => (
					<span class="rounded-button border border-border bg-background px-2 py-1 text-xs text-text-muted">
						{genre}
					</span>
				))
			}
		</div>

		<h3 class="text-lg font-semibold leading-snug text-text">
			<a
				href={`/games/${game.slug}`}
				class="hover:text-accent focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
			>
				{game.title}
			</a>
		</h3>

		<p class="line-clamp-3 text-sm text-text-muted">{game.shortDescription}</p>

		<div class="mt-auto pt-1">
			<a
				href={`/games/${game.slug}`}
				class="inline-flex items-center gap-1 text-sm font-semibold text-accent hover:text-accent-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-accent"
			>
				Xem chi tiết <span aria-hidden="true">→</span>
			</a>
		</div>
	</div>
</article>
